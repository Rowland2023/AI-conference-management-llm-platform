# App
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database - Postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=conference_management
DB_POOL_MIN=2
DB_POOL_MAX=10
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/conference_management

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=conference-management
KAFKA_GROUP_ID=conference-management-group
KAFKA_CONN_TIMEOUT=3000
KAFKA_REQUEST_TIMEOUT=30000
KAFKA_RETRY_RETRIES=5
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_SSL=false

# JWT / Auth
JWT_SECRET=your-super-secret-jwt-key-change-in-prod
JWT_EXPIRES_IN=1h
JWT_JWKS_URI=https://your-auth-provider/.well-known/jwks.json
JWT_ISSUER=conference-management
JWT_AUDIENCE=conference-management-api
REFRESH_TOKEN_SECRET=your-refresh-secret
REFRESH_TOKEN_EXPIRES_IN=7d

# Paystack / Stripe
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx

# OpenAI
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=10000

# Email / SMS
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@conference.local

# Frontend / CORS
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Outbox / Workers
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_BATCH_SIZE=100
WORKER_CONCURRENCY=10

# Metrics / Tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Auth & DB
AUTH_PROVIDER=local
DB_SSL=false

# Kafka
KAFKA_CONSUMER_GROUP_ID=conference-group
KAFKA_CONSUMER_HEARTBEAT_INTERVAL=3000
KAFKA_CONSUMER_REBALANCE_TIMEOUT=60000
KAFKA_CONSUMER_SESSION_TIMEOUT=30000
KAFKA_GROUP=conference-group
KAFKA_PRODUCER_TRX_TIMEOUT=30000
KAFKA_REQ_TIMEOUT=30000
KAFKA_RETRY_COUNT=5
KAFKA_RETRY_INITIAL_TIME=300
KAFKA_SASL_MECHANISM=plain
KAFKA_SSL_ENABLED=false

# Payments
PAYSTACK_WEBHOOK_SECRET=whsec_test
REDIS_PASSWORD=
